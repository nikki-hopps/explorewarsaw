{
  // Cloudflare Workers deployment: the landing page as static assets plus the e-book delivery API.
  "name": "explorewarsaw",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // The real addresses. Cloudflare creates the DNS records for these itself.
  "routes": [
    { "pattern": "www.explorewarsawguide.com", "custom_domain": true },
    { "pattern": "explorewarsawguide.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./landing",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    // Private bucket holding the e-book files (public access stays off).
    { "binding": "EBOOKS", "bucket_name": "book-explore-warsaw-2024" }
  ],
  // Keep request logs on so problems with downloads and emails can be traced.
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  },
  "kv_namespaces": [
    // Download counter and "email already sent" markers. Wrangler creates it on the first deploy.
    { "binding": "DELIVERIES" }
  ]
}
